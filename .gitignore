# Secrets — never commit the NASS key
.env

# Python
.venv/
__pycache__/
*.pyc

# Data artifacts (regenerable via the pipeline)
data/raw/
data/processed/
*.parquet

# 134MB CSV dump of data/processed/features_corn.parquet, used by the
# notebooks. Regenerate with:
#   python -c "import pandas as pd; \
#     pd.read_parquet('data/processed/features_corn.parquet') \
#       .to_csv('notebooks/data.csv', index=False)"
notebooks/data.csv

# Node / Vite
web/node_modules/
web/dist/

# web/public/data/ is deliberately NOT ignored: those files are generated by
# the pipeline but the deploy only builds the frontend, so they have to be in
# the repo.

# OS
.DS_Store

# Local screenshot originals; the published copy is web/public/og.png
.screenshots/
